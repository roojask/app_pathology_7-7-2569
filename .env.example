# ====================================================================
# Pathology Voice Assistant - Environment Configuration Template
# Copy this file to '.env' and populate with your credentials.
# DO NOT commit the '.env' file containing actual keys to version control.
# ====================================================================

# Database connection URL (e.g. postgresql://user:password@localhost:5432/dbname)
# If left empty, the application will fallback to local SQLite for safety.
DATABASE_URL=

# Groq Cloud API Key for Whisper Speech-To-Text transcription.
# Get your key at https://console.groq.com/
GROQ_API_KEY=

# Supabase Configuration (URL and Secret Key/service_role equivalent)
SUPABASE_URL=
SUPABASE_KEY=

# Enable HTTPS (True/False). Default is True.
USE_HTTPS=True

# Secret key for Flask session security. Override in production.
SECRET_KEY=pathology-secret-override-this-in-production
